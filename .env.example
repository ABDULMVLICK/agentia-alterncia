# ============================================================================
# Alterncia Prospection Agent — Configuration
# ============================================================================

# --- Turso (DB persistante — REQUIS sur Vercel, optionnel en local) ---
# Sans ces 2 vars, fallback en SQLite local: ./data/agent.db (ne persiste pas sur Vercel)
# Crée une DB gratuite : turso db create alterncia-agent
TURSO_DATABASE_URL=libsql://your-db-xxxxx.turso.io
TURSO_AUTH_TOKEN=

# --- Anthropic (matching + email drafting) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- France Travail API (free public OAuth2 — pôle emploi) ---
# Crée un compte sur https://francetravail.io et active "Offres d'emploi v2"
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Firebase Admin (lire les étudiants Alterncia) ---
# Soit FIREBASE_SERVICE_ACCOUNT_JSON (JSON inline base64 pour Vercel)
# Soit GOOGLE_APPLICATION_CREDENTIALS (chemin local vers le fichier .json)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# --- Agent auth (basique pour protéger l'UI en prod) ---
AGENT_ACCESS_TOKEN=change-me-strong-secret

# --- Limites par run (cost control) ---
AGENT_MAX_OFFERS_PER_RUN=40
AGENT_MAX_MATCHES_PER_OFFER=3
AGENT_MIN_SCORE=72
